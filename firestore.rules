rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuários: leem/seu próprio doc; create/update NÃO permite definir role/storeID
    // (esses campos são gerenciados pelo backend via Admin SDK / Cloud Functions).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == null
        && request.resource.data.storeID == null;
      allow update: if request.auth != null
        && request.auth.uid == userId
        // campo role/storeID são imutáveis pelo cliente (não podem mudar e não podem surgir em create)
        && request.resource.data.role == resource.data.role
        && request.resource.data.storeID == resource.data.storeID;
      allow delete: if false;
    }

    // Alertas: só a loja do usuário (custom claim storeID)
    match /alerts/{alertId} {
      allow read: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
      allow create: if request.auth != null
        && request.resource.data.storeID == request.auth.token.storeID;
      allow update: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID;
      allow delete: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
    }

    // Sugestões: só a loja do usuário
    match /suggestions/{suggestionId} {
      allow read: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
      allow create: if request.auth != null
        && request.resource.data.storeID == request.auth.token.storeID;
      allow update: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID;
      allow delete: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
    }

    // Produtos: por loja (leitura para todos, escrita só gerente/dono)
    match /products/{productId} {
      allow read: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID;
      allow create: if request.auth != null
        && request.auth.token.role in ['GERENTE', 'DONO']
        && request.resource.data.storeID == request.auth.token.storeID;
      allow update: if request.auth != null
        && request.auth.token.role in ['GERENTE', 'DONO']
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID;
      allow delete: if request.auth != null
        && request.auth.token.role in ['GERENTE', 'DONO']
        && resource.data.storeID == request.auth.token.storeID;
    }

    // Avaria/Danos: por loja
    match /damages/{damageId} {
      allow read: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
      allow create: if request.auth != null && request.resource.data.storeID == request.auth.token.storeID;
      allow update: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID;
      allow delete: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
    }

    // Inventário: por loja (create usa request.resource; update valida ambos; delete usa resource)
    match /inventory/{inventoryId} {
      allow read: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
      allow create: if request.auth != null
        && request.resource.data.storeID == request.auth.token.storeID;
      allow update: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID;
      allow delete: if request.auth != null && resource.data.storeID == request.auth.token.storeID;
    }

    // storeUsers: DONO pode gerenciar; create usa request.resource; update valida ambos
    match /storeUsers/{storeUserId} {
      allow read: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.auth.token.role == 'DONO';
      allow create: if request.auth != null
        && request.resource.data.storeID == request.auth.token.storeID
        && request.auth.token.role == 'DONO';
      allow update: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeID == request.auth.token.storeID
        && request.auth.token.role == 'DONO';
      allow delete: if request.auth != null
        && resource.data.storeID == request.auth.token.storeID
        && request.auth.token.role == 'DONO';
    }

    // FCM registration belongs to the authenticated device owner. Store and
    // role are bound to claims so a device cannot enroll for another store.
    match /posNotificationDevices/{deviceId} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.storeID == request.auth.token.storeID
        && request.resource.data.storeKey == string(request.auth.token.storeID)
        && request.resource.data.role == request.auth.token.role
        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() > 0
        && request.resource.data.fcmToken.size() <= 4096;
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Only managers/owners can review requests in their own store. A decision
    // is an immutable one-way transition from PENDING to APPROVED or REJECTED.
    match /posApprovals/{requestId} {
      function isStoreManager() {
        return request.auth != null
          && resource.data.storeKey == string(request.auth.token.storeID)
          && request.auth.token.role in ['GERENTE', 'DONO', 'MANAGER', 'OWNER'];
      }

      allow read: if isStoreManager();
      allow create, delete: if false;
      allow update: if isStoreManager()
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'REJECTED']
        && request.resource.data.storeID == resource.data.storeID
        && request.resource.data.storeKey == resource.data.storeKey
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.decisionUid == request.auth.uid
        && request.resource.data.decisionAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decisionUid', 'decisionObservation', 'decisionAt'
        ]);
    }
  }
}
