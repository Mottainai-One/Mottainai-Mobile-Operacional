rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: pega storeId/role do documento do usuário logado (aceita storeId ou storeID)
    function getStoreId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.storeID || userDoc.data.storeId;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: pega storeId do recurso (aceita storeId ou storeID)
    function getResourceStoreId(resource) {
      return resource.data.storeID || resource.data.storeId;
    }

    // Usuários só leem/escrevem seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Alertas: só a loja do usuário
    match /alerts/{alertId} {
      allow read, listen: if request.auth != null && getResourceStoreId(resource) == getStoreId();
      allow write: if request.auth != null && getResourceStoreId(request.resource) == getStoreId();
    }

    // Sugestões: só a loja do usuário
    match /suggestions/{suggestionId} {
      allow read: if request.auth != null && getResourceStoreId(resource) == getStoreId();
      allow write: if request.auth != null && getResourceStoreId(request.resource) == getStoreId();
    }

    // Produtos: por loja (leitura para todos da loja, escrita só gerente/dono)
    match /products/{productId} {
      allow read: if request.auth != null && getResourceStoreId(resource) == getStoreId();
      allow write: if request.auth != null 
        && getRole() in ['gerente', 'dono']
        && getResourceStoreId(request.resource) == getStoreId();
    }

    // Avaria/Danos: por loja
    match /damages/{damageId} {
      allow read: if request.auth != null && getResourceStoreId(resource) == getStoreId();
      allow write: if request.auth != null && getResourceStoreId(request.resource) == getStoreId();
    }

    // Inventário: por loja
    match /inventory/{inventoryId} {
      allow read, write: if request.auth != null && getResourceStoreId(resource) == getStoreId();
    }

    // Usuários da loja (para Dono gerenciar equipe)
    match /storeUsers/{storeUserId} {
      allow read, write: if request.auth != null 
        && getResourceStoreId(resource) == getStoreId()
        && getRole() == 'dono';
    }
  }
}