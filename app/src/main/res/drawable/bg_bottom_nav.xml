<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo da barra inferior: branco com um fio de separacao no topo.
     Usamos o fio em vez de sombra para que o FAB possa ficar por cima da
     barra (a sombra exigiria elevacao, e elevacao reordena o desenho). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/divider_grey" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
        </shape>
    </item>
</layer-list>
