<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background">

    <LinearLayout
        android:id="@+id/products_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/products_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/op_catalog_title"
            android:textColor="@color/op_text"
            android:textSize="18sp" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/sv_product_search"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/op_input"
            android:iconifiedByDefault="false"
            android:queryHint="@string/op_search_products"
            app:searchHintIcon="@null" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_products"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@color/op_background"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/op_nav_active"
            app:tabIndicatorColor="@color/op_soft"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/op_link"
            app:tabTextColor="@color/op_muted" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/products_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/products_header" />

</androidx.constraintlayout.widget.ConstraintLayout>
