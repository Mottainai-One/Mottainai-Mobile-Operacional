<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_welcome"
            style="@style/TextAppearance.Op.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Operação em dia" />

        <TextView
            android:id="@+id/tv_store_info"
            style="@style/TextAppearance.Op.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Gerente — Mercado da Praça" />

        <ProgressBar
            android:id="@+id/progress_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/container_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/op_soft_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_error"
                style="@style/TextAppearance.Op.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/retry"
                android:textAllCaps="false"
                android:textColor="@color/op_on_brand" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Estoquista: tarefa, fila e progresso do turno. -->
            <LinearLayout
                android:id="@+id/home_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:background="@drawable/op_hero">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/op_next_task"
                            android:textColor="@color/op_on_brand"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/stock_hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/op_task_unavailable"
                            android:textColor="@color/op_on_brand"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            tools:text="Abastecimento da gôndola" />
                        <TextView
                            android:id="@+id/stock_hero_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/op_tasks_not_connected"
                            android:textColor="@color/op_on_brand"
                            android:textSize="13sp"
                            tools:text="Separar 6 unidades — corredor 03" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="146dp"
                        android:layout_height="85dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:src="@drawable/op_brand_stock_art" />
                    <Button
                        android:id="@+id/btn_stock_inventory"
                        android:layout_width="208dp"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/op_button_accent"
                        android:text="@string/op_view_inventory"
                        android:textAllCaps="false"
                        android:textColor="@color/op_on_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>
                <Button
                    android:id="@+id/btn_stock_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/op_card"
                    android:text="@string/op_view_tasks"
                    android:textAllCaps="false"
                    android:textColor="@color/op_link"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/TextAppearance.Op.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/op_queue" />
                <TextView
                    android:id="@+id/stock_alerts_empty"
                    style="@style/TextAppearance.Op.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/op_no_stock_alerts" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_stock_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />
                <TextView
                    android:id="@+id/stock_progress_label"
                    style="@style/TextAppearance.Op.CardHeading"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/op_soft_card"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:text="@string/op_progress_unavailable" />
            </LinearLayout>

            <!-- Gerente: indicadores da operação e atenção no estoque. -->
            <LinearLayout
                android:id="@+id/home_manager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:orientation="horizontal">
                    <include layout="@layout/include_home_metric" android:id="@+id/manager_adjustments" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <include layout="@layout/include_home_metric" android:id="@+id/manager_tasks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <include layout="@layout/include_home_metric" android:id="@+id/manager_team" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="152dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/op_hero">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/op_check_now"
                            android:textColor="@color/op_on_brand"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/manager_hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/op_no_suggestions"
                            android:textColor="@color/op_on_brand"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            tools:text="Um lote exige sua atenção" />
                        <TextView
                            android:id="@+id/btn_manager_suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center_vertical"
                            android:text="@string/op_review_suggestion"
                            android:textColor="@color/op_on_brand"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="146dp"
                        android:layout_height="85dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@null"
                        android:scaleType="fitEnd"
                        android:src="@drawable/op_brand_manager_art" />
                </FrameLayout>
                <Button
                    android:id="@+id/btn_manager_conferences"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/op_button_outline"
                    android:text="@string/op_conferences"
                    android:textAllCaps="false"
                    android:textColor="@color/op_link"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    style="@style/TextAppearance.Op.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/op_stock_attention" />
                <TextView
                    android:id="@+id/manager_alerts_empty"
                    style="@style/TextAppearance.Op.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/op_no_stock_alerts" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_manager_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Dono: dados financeiros aguardam integração própria. -->
            <LinearLayout
                android:id="@+id/home_owner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:background="@drawable/op_hero"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/op_month_sales"
                        android:textColor="@color/op_on_brand"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/owner_sales"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/op_data_unavailable"
                        android:textColor="@color/op_on_brand"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/op_sales_caption"
                        android:textColor="@color/op_on_brand"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <include layout="@layout/include_home_metric" android:id="@+id/owner_losses" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                    <include layout="@layout/include_home_metric" android:id="@+id/owner_low_stock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                </LinearLayout>
                <TextView
                    style="@style/TextAppearance.Op.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/op_store_products" />
                <LinearLayout
                    android:id="@+id/btn_owner_inventory"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/op_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/op_milk" />
                    <TextView
                        style="@style/TextAppearance.Op.CardHeading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/op_open_inventory" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btn_owner_report"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/op_soft_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/op_leaf" />
                    <TextView
                        style="@style/TextAppearance.Op.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/op_risk_summary"
                        android:textColor="@color/op_text" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_owner_count_reviews"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    android:text="@string/op_owner_count_reviews"
                    android:textAllCaps="false"
                    android:textColor="@color/op_link"
                    app:strokeColor="@color/op_outline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
