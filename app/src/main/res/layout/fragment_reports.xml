<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/op_report_period"
            android:textColor="@color/op_text"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/op_report_example_label"
            android:textColor="@color/op_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/btn_month" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/op_report_month"
                android:textColor="@color/op_link" android:textSize="15sp" />
            <TextView android:id="@+id/btn_week" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/op_report_week"
                android:textColor="@color/op_muted" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/btn_sales" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/op_report_sales"
                android:textColor="@color/op_muted" android:textSize="15sp" />
            <TextView android:id="@+id/btn_losses" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:text="@string/op_report_losses"
                android:textColor="@color/op_link" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/op_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:id="@+id/tv_chart_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/op_text" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_report_total" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/op_text" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_selected_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/op_muted" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="200dp"
                android:layout_marginTop="20dp" android:orientation="horizontal">
                <include android:id="@+id/report_bar_1" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_2" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_3" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_4" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_5" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_6" layout="@layout/item_report_bar" />
                <include android:id="@+id/report_bar_7" layout="@layout/item_report_bar" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/op_report_bar_hint"
                android:textColor="@color/op_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/op_soft_card"
            android:padding="16dp"
            android:text="@string/op_report_live_unavailable"
            android:textColor="@color/op_muted"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_inventory"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="16dp" android:backgroundTint="@color/op_brand"
            android:text="@string/op_report_open_inventory" android:textAllCaps="false"
            android:textColor="@color/op_on_brand" />
    </LinearLayout>
</ScrollView>
