<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/op_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding_vertical">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/op_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/product_detail_title"
            android:textColor="@color/op_text"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="@dimen/screen_padding">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/op_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <ProgressBar
                android:id="@+id/progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/error_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Erro ao carregar produto"
                    android:textColor="@color/op_text"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/op_brand"
                    android:textAllCaps="false"
                    android:textColor="@color/op_on_brand"
                    app:cornerRadius="12dp"
                    android:text="@string/retry" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_product_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/op_soft"
                android:padding="64dp"
                android:scaleType="fitCenter"
                android:src="@drawable/op_box"
                android:contentDescription="@string/product_image"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Produto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/op_text"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_product_sku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SKU: 000000"
                android:textSize="14sp"
                android:textColor="@color/op_muted"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tv_product_quantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quantidade: 0"
                    android:textSize="16sp"
                    android:textColor="@color/op_text" />

                <TextView
                    android:id="@+id/tv_product_min_quantity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mínimo: 0"
                    android:textSize="16sp"
                    android:textColor="@color/op_muted"
                    android:gravity="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_product_batch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lote: —"
                android:textSize="14sp"
                android:textColor="@color/op_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_product_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Validade: —"
                android:textSize="14sp"
                android:textColor="@color/op_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_product_supplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fornecedor: —"
                android:textSize="14sp"
                android:textColor="@color/op_muted"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_product_store"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loja: —"
                android:textSize="14sp"
                android:textColor="@color/op_muted"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register_damage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                android:text="@string/register_damage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:backgroundTint="@color/op_brand"
                android:textColor="@color/op_on_brand"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                android:text="@string/edit_product"
                android:visibility="gone" />

        </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>