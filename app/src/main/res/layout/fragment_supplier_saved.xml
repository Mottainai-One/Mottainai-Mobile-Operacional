<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="16dp">
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/op_supplier_success" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/op_supplier_saved_title"
        android:textColor="@color/op_text"
        android:textSize="28sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/op_supplier_saved_message"
        android:textColor="@color/op_muted"
        android:textSize="16sp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_suppliers"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/op_brand"
        android:text="@string/op_supplier_back"
        android:textAllCaps="false"
        android:textColor="@color/op_on_brand" />
</LinearLayout>
