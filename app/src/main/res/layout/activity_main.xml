<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background">

    <LinearLayout
        android:id="@+id/op_header"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/op_back"
            android:padding="14dp"
            android:src="@drawable/op_back"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/op_logo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_name"
            android:layout_weight="1"
            android:maxWidth="216dp"
            android:scaleType="fitCenter"
            android:src="@drawable/op_logo" />

        <TextView
            android:id="@+id/op_header_title"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/op_text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_pos_approvals"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/op_open_pos_approvals"
            android:padding="12dp"
            android:src="@drawable/ic_notification"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_assistant"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/op_open_assistant"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/op_assistant" />

        <ImageButton
            android:id="@+id/btn_theme"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/op_theme_background"
            android:contentDescription="@string/op_toggle_theme"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/op_theme_icon" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/op_header"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.App.BottomNav"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scan"
        style="@style/Widget.App.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/fab_scan_description"
        android:src="@drawable/op_nav_scanner"
        android:translationY="-26dp"
        app:fabCustomSize="40dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
