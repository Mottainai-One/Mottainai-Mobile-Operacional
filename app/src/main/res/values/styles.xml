<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Op.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Op.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Op.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/op_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.Op.CardHeading" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
        <item name="android:background">@drawable/op_nav_background</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemRippleColor">@color/bottom_nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemPaddingTop">@dimen/bottom_nav_item_padding_top</item>
        <item name="itemPaddingBottom">@dimen/bottom_nav_item_padding_bottom</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.ActiveIndicator</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.BottomNav.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/op_soft</item>
    </style>

    <style name="Widget.App.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/op_scanner_background</item>
        <item name="tint">@color/op_scanner_foreground</item>
        <item name="elevation">0dp</item>
        <item name="borderWidth">0dp</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_corner_radius</item>
        <item name="hintTextColor">@color/op_link</item>
        <item name="android:textColorHint">@color/op_muted</item>
    </style>

    <!-- Campos de seleção (dropdown) precisam do estilo ExposedDropdownMenu:
         com o estilo de campo de texto comum o Material não aplica o padding
         interno correto e o rótulo vaza para fora da borda. -->
    <style name="Widget.App.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/card_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/card_corner_radius</item>
        <item name="hintTextColor">@color/op_link</item>
        <item name="android:textColorHint">@color/op_muted</item>
        <item name="endIconTint">@color/op_link</item>
    </style>
</resources>
